NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional for protected Vercel Preview only: anonymous reads of public catalogue
# data. These names do not enable preview accounts or database writes.
PREVIEW_CATALOG_SUPABASE_URL=
PREVIEW_CATALOG_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
CRON_SECRET=
OPENAI_API_KEY=

# Payment checkout stays disabled unless explicitly enabled after settlement review.
PAYMENTS_ENABLED=false
PAYSTACK_SECRET_KEY=

# Supplier plan billing is separate from buyer order payments. Leave disabled
# until legal registration, Paystack approval, staging tests and review.
SUBSCRIPTION_PAYMENTS_ENABLED=false
SUBSCRIPTION_PAYMENTS_MODE=
SUBSCRIPTION_LIVE_APPROVED=false
SUBSCRIPTION_USD_ENABLED=false
PAYSTACK_SUBSCRIPTION_SECRET_KEY=
PAYSTACK_SUBSCRIPTION_WEBHOOK_SECRET=
# Required for test-mode billing; must match NEXT_PUBLIC_SUPABASE_URL project ref.
SUBSCRIPTION_TEST_PROJECT_REF=
